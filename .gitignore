# Godot 4+ specific ignores (Godot's defaults — keep)
.godot/
/android/

# Defensive: Mono artifacts (project is GDScript-only but guard against accidents)
.mono/
data_*/
mono_crash.*.json

# Build / export artifacts
build/
export/
*.pck

# System / editor cruft
.DS_Store
*.swp
*.tmp

# Claude Code per-machine local overrides (global .claude/settings.json IS tracked)
.claude/settings.local.json

# godot-api skill: generated/cloned content (bootstrap script regenerates on demand)
.claude/skills/godot-api/doc_source/
.claude/skills/godot-api/doc_api/

# Python bytecode (from skill helper scripts)
__pycache__/
*.pyc

# Project-local Python virtualenv for tools/ (rebuild via: python -m venv .venv)
.venv/

# Secrets — KEY=VALUE config for tools/ (commit .env.example as the template)
.env
.env.local

# Aseprite local backups
*.aseprite-bak

# QA screenshots — ephemeral; attach to PRs or ntfy-deliver, never commit
screenshots/
