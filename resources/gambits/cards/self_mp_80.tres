[gd_resource type="Resource" script_class="GambitCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/gambit_card.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"self_mp_80"
display_name = "Self < 80% MP"
flavor = "Fires when this character's MP drops below 80%. Targets self."
trigger_expr = "self_mp_lt_80"
target_selector = &"self"
