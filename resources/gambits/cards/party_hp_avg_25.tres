[gd_resource type="Resource" script_class="GambitCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/gambit_card.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"party_hp_avg_25"
display_name = "Party HP < 25% Avg"
flavor = "Fires when the party's average HP drops below 25%. Targets the most-damaged ally."
trigger_expr = "party_hp_avg_lt_25"
target_selector = &"ally_most_damaged"
